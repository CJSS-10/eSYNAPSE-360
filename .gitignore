# eSYNAPSE 360 — Exclusiones del repositorio

# Python / Django
backend/venv/
backend/db.sqlite3
backend/*.sqlite3
__pycache__/
*.pyc

# Node / React
frontend/node_modules/
frontend/dist/

# Entornos y secretos
.env
.env.local
*.log

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Archivos subidos por usuarios (documentos, evidencias)
backend/media/
backend/media_pruebas/

# Certificados digitales y llaves privadas — JAMAS al repositorio
*.pfx
*.p12
*.pem
*.key
backend/certificados/

# Respaldos locales de base de datos y archivos
backend/backups/
backups/
*.bak
obser.txt
Guia.txt

# Residuos del taller (se archivan, no se borran)
backend/_renametest3/
_archivo/

# Carpeta canónica limpia (no versionar dentro del taller)
eSYNAPSE 360 GitHub/
_evicted_backups_*/
